lexer grammar SysYLexer;

CONST: 'const';

INT: 'int';

VOID: 'void';

IF: 'if';

ELSE: 'else';

WHILE: 'while';

BREAK: 'break';

CONTINUE: 'continue';

RETURN: 'return';

PLUS: '+';

MINUS: '-';

MUL: '*';

DIV: '/';

MOD: '%';

ASSIGN: '=';

EQ: '==';

NEQ: '!=';

LT: '<';

GT: '>';

LE: '<=';

GE: '>=';

NOT: '!';

AND: '&&';

OR: '||';

L_PAREN: '(';

R_PAREN: ')';

L_BRACE: '{';

R_BRACE: '}';

L_BRACKT: '[';

R_BRACKT: ']';

COMMA: ',';

SEMICOLON: ';';

IDENT: # TODO

INTEGER_CONST: # TODO

WS
  : # TODO
   ;

LINE_COMMENT
  : # TODO
   ;

MULTILINE_COMMENT
  : # TODO
